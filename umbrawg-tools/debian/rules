#!/usr/bin/make -f

include /usr/share/dpkg/default.mk

export CARGO_HOME := $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR := $(CURDIR)/target

%:
	dh $@

override_dh_auto_build:
	@test -d ../netlink-packet-umbrawg || { \
		echo "error: ../netlink-packet-umbrawg is required by the path dependency" >&2; \
		echo "error: see debian/README.source for the expected source layout" >&2; \
		exit 1; \
	}
	cargo build --release -p uwg -p uwg-quick

override_dh_auto_test:
	@if echo " $(DEB_BUILD_OPTIONS) " | grep -q " nocheck "; then \
		echo "dh_auto_test: skipped (DEB_BUILD_OPTIONS contains nocheck)"; \
	else \
		cargo test --workspace; \
	fi

override_dh_auto_clean:
	cargo clean || true
	rm -rf debian/cargo-home

override_dh_auto_install:
	install -Dm755 target/release/uwg debian/umbrawg-tools/usr/bin/uwg
	install -Dm755 target/release/uwg-quick debian/umbrawg-tools/usr/bin/uwg-quick
	install -Dm644 man/uwg.8 debian/umbrawg-tools/usr/share/man/man8/uwg.8
	install -Dm644 man/uwg-quick.8 debian/umbrawg-tools/usr/share/man/man8/uwg-quick.8
	install -Dm644 completions/uwg.bash debian/umbrawg-tools/usr/share/bash-completion/completions/uwg
	install -Dm644 completions/uwg-quick.bash debian/umbrawg-tools/usr/share/bash-completion/completions/uwg-quick
	install -Dm644 completions/_uwg debian/umbrawg-tools/usr/share/zsh/vendor-completions/_uwg
	install -Dm644 completions/_uwg-quick debian/umbrawg-tools/usr/share/zsh/vendor-completions/_uwg-quick
	install -Dm644 completions/uwg.fish debian/umbrawg-tools/usr/share/fish/vendor_completions.d/uwg.fish
	install -Dm644 completions/uwg-quick.fish debian/umbrawg-tools/usr/share/fish/vendor_completions.d/uwg-quick.fish
	install -Dm644 systemd/uwg-quick@.service debian/umbrawg-tools/lib/systemd/system/uwg-quick@.service
	install -Dm644 systemd/uwg-quick.target debian/umbrawg-tools/lib/systemd/system/uwg-quick.target
	install -Dm644 systemd/umbrawg@.service debian/umbrawg-tools/lib/systemd/system/umbrawg@.service
	install -d -m 0700 debian/umbrawg-tools/etc/umbrawg

override_dh_fixperms:
	dh_fixperms -Xetc/umbrawg

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md
