kprobe:__queue_work { @queue_work[comm] = count(); }
kprobe:uwg_packet_encrypt_worker
{
	@encrypt = count();
	@enc_start[tid] = nsecs;
}
kretprobe:uwg_packet_encrypt_worker
/@enc_start[tid]/
{
	@encrypt_ns = hist(nsecs - @enc_start[tid]);
	delete(@enc_start[tid]);
}
kprobe:uwg_packet_decrypt_worker
{
	@decrypt = count();
	@dec_start[tid] = nsecs;
}
kretprobe:uwg_packet_decrypt_worker
/@dec_start[tid]/
{
	@decrypt_ns = hist(nsecs - @dec_start[tid]);
	delete(@dec_start[tid]);
}
kprobe:uwg_packet_tx_worker { @tx_worker = count(); }
kprobe:uwg_packet_rx_poll { @rx_poll = count(); }
kprobe:uwg_packet_receive { @receive = count(); }
kprobe:dev_queue_xmit { @dev_queue_xmit = count(); }
interval:s:10 { exit(); }
